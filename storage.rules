rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /profile_pictures/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    match /chat_uploads/{chatId}/{allPaths=**} {
      allow read: if isAuthenticated() && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberUids;
      allow write: if isAuthenticated() && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberUids;
    }

    match /trip_receipts/{tripId}/{allPaths=**} {
      allow read: if isAuthenticated() && request.auth.uid in firestore.get(/databases/(default)/documents/trips/$(tripId)).data.memberUids;
      allow write: if isAuthenticated() && request.auth.uid in firestore.get(/databases/(default)/documents/trips/$(tripId)).data.memberUids;
    }

    match /ai_uploads/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }
  }
}
