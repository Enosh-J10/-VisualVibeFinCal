rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getChat(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function isChatMember(chatId) {
      return isAuthenticated() && request.auth.uid in getChat(chatId).memberUids;
    }

    // Secure Chat Rules
    match /chats/{chatId} {
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.memberUids;
      allow read, update: if isAuthenticated() && request.auth.uid in resource.data.memberUids;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId) && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if isChatMember(chatId) && resource.data.senderUid == request.auth.uid;
      }

      match /status/{uid} {
        allow read: if isChatMember(chatId);
        allow write: if isOwner(uid) && isChatMember(chatId);
      }
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);

      match /friendSettings/{friendId} {
        allow read, write: if isOwner(userId);
      }
      match /blockedUsers/{blockedId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Friend Requests Rules
    match /friendRequests/{requestId} {
      // Allow create only if fromUid matches auth user and status is pending
      allow create: if isAuthenticated() &&
                    request.resource.data.fromUid == request.auth.uid &&
                    request.resource.data.status == "pending" &&
                    requestId == request.auth.uid + "_" + request.resource.data.toUid;

      // Allow read/update/delete if user is involved in the request
      allow read, update, delete: if isAuthenticated() &&
                                   (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // Friends Rules
    match /friends/{friendshipId} {
      allow read, create, update, delete: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
    }

    match /trips/{tripId} {
      allow create: if isAuthenticated() && request.resource.data.createdByUid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && (request.auth.uid in resource.data.memberUids || request.auth.uid == resource.data.createdByUid);

      match /expenses/{expenseId} {
        // Secure expense access - must be trip member
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids || request.auth.uid == get(/databases/$(database)/documents/trips/$(tripId)).data.createdByUid);
        allow create: if isAuthenticated() && request.resource.data.createdByUid == request.auth.uid;
        allow update, delete: if isAuthenticated() && request.resource.data.createdByUid == request.auth.uid;
      }
    }

    match /business/{docId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /notes/{noteId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
  }
}
